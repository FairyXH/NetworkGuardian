<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!--
      CA1416: platform compatibility is enforced by the per-project target frameworks instead.
      CA1822/CA1873/CA1848: micro-optimisation style rules that add noise without changing behaviour.
      CS1591: XML documentation is intentionally partial.
    -->
    <NoWarn>$(NoWarn);CA1416;CS1591;CA1822;CA1873;CA1848;CA1303;CA1031;CA2007;CA1062;CA5394</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>NetworkGuardian</Product>
    <Company>NetworkGuardian</Company>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <InformationalVersion>0.9.0</InformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

</Project>
