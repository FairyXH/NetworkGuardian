<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NetworkGuardian.Tests</RootNamespace>
    <AssemblyName>NetworkGuardian.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <!-- The layout tests read the fixed buffers inside the native structs directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1861;CA1707;xUnit1030;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetworkGuardian.Core\NetworkGuardian.Core.csproj" />
    <ProjectReference Include="..\..\src\NetworkGuardian.Infrastructure\NetworkGuardian.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NetworkGuardian.Windows\NetworkGuardian.Windows.csproj" />
  </ItemGroup>

</Project>
