<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Plain net8.0-windows on purpose: a versioned Windows TFM references Microsoft.Windows.SDK.NET.dll
      (the ~24 MB WinRT projection), which Native AOT cannot use. Every Windows capability in this
      project goes through P/Invoke.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NetworkGuardian.Windows</RootNamespace>
    <AssemblyName>NetworkGuardian.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkGuardian.Core\NetworkGuardian.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <!-- The native interop layer stays internal, but the test project asserts its SDK-locked values. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NetworkGuardian.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
