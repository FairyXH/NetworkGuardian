<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Plain net8.0-windows: a versioned Windows TFM would reference Microsoft.Windows.SDK.NET.dll (the
      ~24 MB WinRT projection), which Native AOT cannot use. The UI in this project is drawn with GDI
      through P/Invoke, so there is nothing to project.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NetworkGuardian.Portable</RootNamespace>
    <AssemblyName>NetworkGuardian</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- PAINTSTRUCT and friends carry fixed buffers; the interop layer is inherently unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      CA1806: the return values of GDI/user32 drawing calls carry no information we can act on, and
      every such call in this project is deliberately fire-and-forget.
      CA2020: the IntPtr -> int conversions unpack LPARAM mouse coordinates; wrapping them in
      checked() would only add a branch to a hot path that cannot overflow by construction.
    -->
    <NoWarn>$(NoWarn);CA1806;CA2020</NoWarn>
    <!-- Referenced projects still produce PDBs; the portable package must not contain any. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Native AOT + size tuning. This is the switch that removes both the ~60 MB .NET runtime and the
      ~90 MB WinUI/Windows App SDK payload, which is the whole point of the portable build:
      a single self-contained exe around 5 MB that starts on a machine with no runtime installed.
    -->
    <PublishAot>true</PublishAot>
    <!-- A native AOT publish is always a single self-contained exe; asking for PublishSingleFile
         as well is rejected by the ILCompiler targets. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local comparison/backup files must not be picked up by the SDK's recursive *.cs glob. -->
    <Compile Remove="**\*.modified.cs;**\*.bak.cs" />
    <ProjectReference Include="..\NetworkGuardian.Core\NetworkGuardian.Core.csproj" />
    <ProjectReference Include="..\NetworkGuardian.Windows\NetworkGuardian.Windows.csproj" />
    <ProjectReference Include="..\NetworkGuardian.Infrastructure\NetworkGuardian.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The privileged helper is compiled into this executable (HelperEntry in NetworkGuardian.Windows)
    and reached through the helper switch, so the published package is a single file.
    NetworkGuardian.Helper is still built as a standalone exe for split deployments, but nothing is
    copied next to the app: a second exe in the package would only add ~3 MB and contradict the
    single-file requirement. (XML comments cannot contain a double hyphen, hence the wording.)
  -->

</Project>
