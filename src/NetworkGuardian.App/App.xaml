<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NetworkGuardian.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:NetworkGuardian.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="AppTextPrimary" Color="#1B1B1F" />
                            <SolidColorBrush x:Key="AppTextSecondary" Color="#5A5A62" />
                            <SolidColorBrush x:Key="AppCardBackground" Color="#F6F6F8" />
                            <SolidColorBrush x:Key="AppCardBorder" Color="#E2E2E6" />
                            <SolidColorBrush x:Key="AppSubtleBackground" Color="#ECECF0" />
                            <SolidColorBrush x:Key="AppGood" Color="#1B7F3B" />
                            <SolidColorBrush x:Key="AppBad" Color="#B3261E" />
                            <SolidColorBrush x:Key="AppWarn" Color="#8A5A00" />
                            <SolidColorBrush x:Key="AppAccent" Color="#0F6CBD" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="AppTextPrimary" Color="#F3F3F3" />
                            <SolidColorBrush x:Key="AppTextSecondary" Color="#B4B4BB" />
                            <SolidColorBrush x:Key="AppCardBackground" Color="#22222A" />
                            <SolidColorBrush x:Key="AppCardBorder" Color="#3A3A44" />
                            <SolidColorBrush x:Key="AppSubtleBackground" Color="#2C2C36" />
                            <SolidColorBrush x:Key="AppGood" Color="#5CD37A" />
                            <SolidColorBrush x:Key="AppBad" Color="#FF8A80" />
                            <SolidColorBrush x:Key="AppWarn" Color="#F2C46B" />
                            <SolidColorBrush x:Key="AppAccent" Color="#7CC4FF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="AppTextPrimary" Color="White" />
                            <SolidColorBrush x:Key="AppTextSecondary" Color="White" />
                            <SolidColorBrush x:Key="AppCardBackground" Color="Black" />
                            <SolidColorBrush x:Key="AppCardBorder" Color="White" />
                            <SolidColorBrush x:Key="AppSubtleBackground" Color="Black" />
                            <SolidColorBrush x:Key="AppGood" Color="Lime" />
                            <SolidColorBrush x:Key="AppBad" Color="Red" />
                            <SolidColorBrush x:Key="AppWarn" Color="Yellow" />
                            <SolidColorBrush x:Key="AppAccent" Color="Cyan" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <Style x:Key="CardBorder" TargetType="Border">
                        <Setter Property="Background" Value="{ThemeResource AppCardBackground}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>

                    <Style x:Key="PageTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="24" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>

                    <Style x:Key="SectionTitle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>

                    <Style x:Key="FieldCaption" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
                        <Setter Property="Margin" Value="0,8,0,2" />
                    </Style>

                    <Style x:Key="BodyText" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
                    </Style>

                    <Style x:Key="ValueText" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="18" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
                    </Style>

                    <Style x:Key="MonoText" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="IsTextSelectionEnabled" Value="True" />
                        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
                    </Style>

                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
