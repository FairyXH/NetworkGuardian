<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NetworkGuardian.App</RootNamespace>
    <AssemblyName>NetworkGuardian</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      The .NET runtime and the Windows App SDK runtime both travel with the app. This is what makes
      the executable start on a machine whose Microsoft.WindowsAppRuntime.1.8 package is older than
      the one the SDK package asks for (the bootstrapper would otherwise show
      "This application could not be started"). Framework-dependent deployment is possible by
      setting both flags to false once a matching Windows App Runtime is installed.
    -->
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      The Windows App SDK runtime is carried next to the executable. That removes the dependency on
      a matching Microsoft.WindowsAppRuntime.* framework package being installed, which is the most
      common reason an unpackaged WinUI 3 app shows "This application could not be started".
      Set to false to go back to a framework-dependent deployment.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <!-- PowerModeChanged (sleep/resume) notifications for a desktop app without WinForms. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkGuardian.Core\NetworkGuardian.Core.csproj" />
    <ProjectReference Include="..\NetworkGuardian.Windows\NetworkGuardian.Windows.csproj" />
    <ProjectReference Include="..\NetworkGuardian.Infrastructure\NetworkGuardian.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The privileged helper ships next to the app so it can be launched on demand. -->
    <HelperSourceDir>$(MSBuildThisFileDirectory)..\NetworkGuardian.Helper\bin\$(Configuration)\net8.0-windows10.0.19041.0\win-x64\</HelperSourceDir>
  </PropertyGroup>

  <Target Name="CopyPrivilegedHelper" AfterTargets="Build"
          Condition="Exists('$(HelperSourceDir)NetworkGuardian.Helper.exe')">
    <ItemGroup>
      <HelperFiles Include="$(HelperSourceDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(HelperFiles)"
          DestinationFiles="@(HelperFiles->'$(OutDir)helper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
