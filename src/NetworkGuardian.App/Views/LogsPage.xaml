<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetworkGuardian.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logging="using:NetworkGuardian.Core.Logging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="日志" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Bind ViewModel.Host.LogDirectory}"
                       Style="{StaticResource MonoText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,12">
            <ComboBox x:Name="LevelCombo"
                      Width="140"
                      Header="等级"
                      ItemsSource="{x:Bind ViewModel.Logs.Levels, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Logs.SelectedLevel, Mode=TwoWay}" />
            <ComboBox x:Name="ChannelCombo"
                      Width="160"
                      Header="分类"
                      ItemsSource="{x:Bind ViewModel.Logs.Channels, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Logs.SelectedChannel, Mode=TwoWay}" />
            <TextBox Width="240"
                     Header="搜索"
                     Text="{x:Bind ViewModel.Logs.SearchText, Mode=TwoWay}" />
            <ToggleSwitch Header="自动滚动" OnContent="开" OffContent="关"
                          IsOn="{x:Bind ViewModel.Logs.AutoScroll, Mode=TwoWay}" />
            <Button Content="刷新" Click="OnRefreshClicked" VerticalAlignment="Bottom" />
            <Button Content="清空缓冲" Click="OnClearClicked" VerticalAlignment="Bottom" />
            <Button Content="打开日志目录" Click="OnOpenLogsClicked" VerticalAlignment="Bottom" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="LogList"
                          Grid.Row="0"
                          ItemsSource="{x:Bind ViewModel.Logs.Entries, Mode=OneWay}"
                          SelectionMode="Extended"
                          BorderThickness="0"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Line}"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="1"
                        Background="{ThemeResource AppSubtleBackground}"
                        BorderBrush="{ThemeResource AppCardBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <TextBlock Text="{x:Bind ViewModel.Logs.StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               Foreground="{ThemeResource AppTextSecondary}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
