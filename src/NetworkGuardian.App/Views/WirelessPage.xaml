<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetworkGuardian.App.Views.WirelessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetworkGuardian.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="无线网卡" Style="{StaticResource PageTitle}" />
            <TextBlock Text="仅管理物理无线网卡；已正常连接的网卡不会被主动切换，扫描结果按网卡分别保存。"
                       Style="{StaticResource BodyText}"
                       Foreground="{ThemeResource AppTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,12">
                <Button Content="重新扫描全部网卡" Click="OnRescanAllClicked" />
                <Button Content="刷新设备" Click="OnRefreshClicked" />
                <ProgressRing IsActive="{x:Bind ViewModel.Wireless.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.Wireless.Status, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyText}"
                           Foreground="{ThemeResource AppTextSecondary}" />
            </StackPanel>
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Wireless.Adapters, Mode=OneWay}"
                  SelectionMode="None"
                  Background="Transparent"
                  BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" MinWidth="820">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding LineConnection, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{Binding LineRadio, Mode=OneWay}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{Binding LineAddresses, Mode=OneWay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding LineInterfaceGuid, Mode=OneWay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding LineDeviceId, Mode=OneWay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding LineScan, Mode=OneWay}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="{Binding LineAttempts, Mode=OneWay}" Style="{StaticResource MonoText}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                    <Button Content="扫描此网卡" Click="OnScanAdapterClicked" MinWidth="140" />
                                    <Button Content="断开" Click="OnDisconnectAdapterClicked" MinWidth="140" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="已保存的配置" Style="{StaticResource FieldCaption}" />
                            <ItemsControl ItemsSource="{Binding Profiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource AppSubtleBackground}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="扫描到的网络（仅列出，可手动连接已保存的）"
                                       Style="{StaticResource FieldCaption}" />
                            <ListView ItemsSource="{Binding Networks}"
                                      SelectionMode="None"
                                      MaxHeight="260"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource AppCardBorder}"
                                      CornerRadius="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Ssid}" Style="{StaticResource BodyText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SignalText}" Style="{StaticResource BodyText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RssiText}" Style="{StaticResource BodyText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding BandText}" Style="{StaticResource BodyText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding ProfileText}" Style="{StaticResource BodyText}" />
                                            <Button Grid.Column="5"
                                                    Content="连接"
                                                    IsEnabled="{Binding CanConnect}"
                                                    Click="OnConnectNetworkClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Expander Grid.Row="1" Header="检测到的无线设备（含被过滤的虚拟网卡）" Margin="0,0,0,8">
            <ListView ItemsSource="{x:Bind ViewModel.Wireless.Devices, Mode=OneWay}" SelectionMode="None" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding DetailLine}" Style="{StaticResource MonoText}" />
                                <TextBlock Text="{Binding Reason}" Style="{StaticResource MonoText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="启用"
                                    IsEnabled="{Binding IsPhysical}"
                                    Click="OnEnableDeviceClicked" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>
    </Grid>
</Page>
