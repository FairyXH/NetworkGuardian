<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetworkGuardian.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="0">

            <TextBlock Text="总览" Style="{StaticResource PageTitle}" />
            <TextBlock Text="系统持续保持现有可用连接，仅在连接失效后才重新选网。"
                       Style="{StaticResource BodyText}"
                       Foreground="{ThemeResource AppTextSecondary}"
                       Margin="0,0,0,16" />

            <Border x:Name="LocationWarningCard"
                    Style="{StaticResource CardBorder}"
                    Visibility="{x:Bind ViewModel.Dashboard.ShowLocationWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Windows 位置权限限制" Style="{StaticResource SectionTitle}"
                               Foreground="{ThemeResource AppWarn}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.LocationWarning, Mode=OneWay}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Internet 状态" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.InternetState, Mode=OneWay}"
                                   Style="{StaticResource ValueText}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.InternetDetail, Mode=OneWay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{ThemeResource AppTextSecondary}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="以太网" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.EthernetState, Mode=OneWay}"
                                   Style="{StaticResource ValueText}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.EthernetDetail, Mode=OneWay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{ThemeResource AppTextSecondary}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="默认路由" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.DefaultRoute, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Wi-Fi 无线电" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.RadioState, Mode=OneWay}" Style="{StaticResource ValueText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="物理无线网卡" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.WifiAdapterCount, Mode=OneWay}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.WifiSummary, Mode=OneWay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{ThemeResource AppTextSecondary}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="恢复状态机" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.RecoveryState, Mode=OneWay}" Style="{StaticResource ValueText}" />
                        <TextBlock Text="{x:Bind ViewModel.Dashboard.Health, Mode=OneWay}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{ThemeResource AppTextSecondary}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,12">
                <StackPanel>
                    <TextBlock Text="恢复与认证" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="最近一次恢复动作" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.LastAction, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.LastActionTime, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               Foreground="{ThemeResource AppTextSecondary}" />
                    <TextBlock Text="连续外网失败次数" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.FailureCount, Mode=OneWay}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="校园网认证" Style="{StaticResource FieldCaption}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.CampusAuthInfo, Mode=OneWay}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="本轮计划的动作" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{x:Bind ViewModel.Dashboard.PendingActions, Mode=OneWay}"
                               Style="{StaticResource MonoText}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
