<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NetworkGuardian.Infrastructure</RootNamespace>
    <AssemblyName>NetworkGuardian.Infrastructure</AssemblyName>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkGuardian.Core\NetworkGuardian.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Abstractions only. The DI based LoggerFactory from Microsoft.Extensions.Logging is reflection
      based and therefore off limits for Native AOT; the host wires the single file logger directly.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

</Project>
